#!/usr/bin/env zsh
set -euo pipefail

DOMAIN="${1:?Usage: nginx-remove <domain>}"
SERVERS_DIR="$(realpath "$HOME/.config/nginx/servers")"
CONFIG="$SERVERS_DIR/$DOMAIN.conf"

[[ -f "$CONFIG" ]] && rm "$CONFIG" && echo "→ Removed $CONFIG"

if grep -q "127.0.0.1 $DOMAIN" /etc/hosts 2>/dev/null; then
    echo "→ Removing $DOMAIN from /etc/hosts (requires sudo)..."
    sudo sed -i '' "/127.0.0.1 $DOMAIN/d" /etc/hosts
fi

echo "→ Reloading nginx..."
brew services restart nginx

echo "✓ Removed $DOMAIN"
